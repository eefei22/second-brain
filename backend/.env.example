DATABASE_URL=postgres://secondbrain:secondbrain@localhost:5432/secondbrain
PORT=4000

# --- AI provider selection ---------------------------------------------
# Which vendor handles chat/summarize/polish, and which handles embeddings.
# Independent knobs — e.g. LLM_PROVIDER=anthropic + EMBEDDING_PROVIDER=voyage
# matches the original requirements-doc architecture; LLM_PROVIDER=openai +
# EMBEDDING_PROVIDER=openai runs on OpenAI alone. See backend/src/services/ai/.
LLM_PROVIDER=openai        # openai | anthropic
EMBEDDING_PROVIDER=openai  # openai | voyage

# --- OpenAI (used when LLM_PROVIDER/EMBEDDING_PROVIDER=openai) ---------
OPENAI_API_KEY=your-openai-key-here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic (used when LLM_PROVIDER=anthropic) -----------------------
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

# --- Voyage (used when EMBEDDING_PROVIDER=voyage) ------------------------
VOYAGE_API_KEY=your-voyage-key-here
VOYAGE_EMBEDDING_MODEL=voyage-3.5
